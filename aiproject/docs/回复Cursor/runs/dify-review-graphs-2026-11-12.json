                "temperature": 0.3
              }
            },
            "prompt_template": [
              {
                "role": "system",
                "text": "你是教育留学机构的「企业智能助手 ENT」，面向内部顾问。\n\n【后端探活结果】\n{{#health_http.body#}}\n若不能看到 status ok，明确提示：请先在本机运行 aiproject\\\\scripts\\\\start_api_for_dify.ps1，且 Dify 容器应使用 host.docker.internal:8000。\n\n【重要】当前 app.main 员工业务 API 可能返回 HTTP 503（公共 JWT 未接入）。禁止在 503 时声称「已录入成功」。\n\n【能力】录入客户 lead_create、查列表 lead_query、看档案 lead_detail、改状态 lead_status、写跟进 lead_follow_up。\n\n【规则】\n1. 用中文回复员工。\n2. 不要编造客户；缺姓名要追问。\n3. 当且仅当意图为 lead_create 且已有 customer_name 时，在回复最后一行追加（无 markdown）：\nENT_ACTION:{\"intent\":\"lead_create\",\"customer_name\":\"张三\",\"contact_info\":\"\",\"intended_country\":\"\",\"intended_major\":\"\",\"source_channel\":\"dify\",\"owner_employee_id\":1}\n4. 当意图 lead_query 时，最后一行：\nENT_ACTION:{\"intent\":\"lead_query\",\"keyword\":\"关键词\"}\n5. 其他意图暂不调用 HTTP，只说明后续将对接 API。",
                "id": "sys-ent-v2"
              }
            ],
            "context": {
              "enabled": false,
              "variable_selector": []
            },
            "vision": {
              "enabled": false
            },
            "memory": {
              "window": {
                "enabled": true,
                "size": 10
              },
              "query_prompt_template": "{{#sys.query#}}\n\n{{#sys.files#}}",
              "role_prefix": {
                "user": "",
                "assistant": ""
              }
            },
            "type": "llm",
            "title": "意图与回复"
          },
          "position": {
            "x": 640,
            "y": 300
          },
          "targetPosition": "left",
          "sourcePosition": "right",
          "width": 244,
          "height": 90,
          "zIndex": 0,
          "positionAbsolute": {
            "x": 640,
            "y": 300
          }
        },
        {
          "id": "code1",
          "type": "custom",
          "data": {
            "code": "import json, re\nfrom urllib.parse import quote\n\ndef main(text: str, query: str):\n    out = {\n        \"skip\": True,\n        \"method\": \"get\",\n        \"http_url\": \"http://host.docker.internal:8000/health\",\n        \"http_body\": \"\",\n        \"intent\": \"other\"\n    }\n    if not text:\n        return out\n    m = re.search(r'ENT_ACTION:(\\{.*\\})', text)\n    if not m:\n        return out\n    try:\n        data = json.loads(m.group(1))\n    except Exception:\n        return out\n    intent = data.get(\"intent\") or \"other\"\n    out[\"intent\"] = intent\n    if intent == \"lead_create\" and data.get(\"customer_name\"):\n        out[\"skip\"] = False\n        out[\"method\"] = \"post\"\n        out[\"http_url\"] = \"http://host.docker.internal:8000/api/v1/consultant/leads\"\n        payload = {k: v for k, v in data.items() if k != \"intent\" and v is not None}\n        payload.setdefault(\"owner_employee_id\", 1)\n        payload.setdefault(\"gender\", \"U\")\n        out[\"http_body\"] = json.dumps(payload, ensure_ascii=False)\n    elif intent == \"lead_query\":\n        out[\"skip\"] = False\n        out[\"method\"] = \"get\"\n        kw = str(data.get(\"keyword\") or query or \"\")\n        out[\"http_url\"] = \"http://host.docker.internal:8000/api/v1/consultant/leads?keyword=\" + quote(kw) + \"&page=1&page_size=10\"\n        out[\"http_body\"] = \"\"\n    return out",
            "code_language": "python3",
            "variables": [
              {
                "variable": "text",
                "value_selector": [
                  "llm1",
                  "text"
                ],
                "value_type": "string"
              },
              {
                "variable": "query",
                "value_selector": [
                  "sys",
                  "query"
                ],
                "value_type": "string"
              }
            ],
