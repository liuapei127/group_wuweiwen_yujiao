            "case_id": "true",
            "logical_operator": "and",
            "conditions": [
              {
                "id": "cond-intent",
                "varType": "string",
                "variable_selector": ["code1", "intent"],
                "comparison_operator": "is not",
                "value": "other"
              }
            ]
          }
        ]
      },
