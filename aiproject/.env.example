DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=education_service
DB_USER=root
DB_PASSWORD=change_me
UPLOAD_DIR=./data/uploads

# 本地联调用服务间 Bearer（勿提交真实值；不等于员工身份）
AUTH_BEARER_TOKEN=

# blocked | trusted_jwt（未实现时等同 blocked）。漏洞复现：uvicorn tests.repro.asgi_app:app
EMPLOYEE_IDENTITY_MODE=blocked

# 启用 BASE 员工认证时使用 base_rs256，HTTPS 门户填写准确的 Origin。
# BASE_PORTAL_ORIGIN=https://portal.example.com
# 本机 HTTP 联调时，Origin 必须使用环回地址，才可设置此选项。
# BASE_LOCAL_INSECURE_COOKIES=false

# BASE RS256 私钥只放在仓库外的文件，或由本机环境注入。不要把真实私钥写进 Git 或数据库。
# 未配置时 JWKS 返回 503。示例字段：kid、status(active|verify_only|disabled)、public_pem；仅 active 可带 private_pem。
# BASE_JWT_KEYS_FILE=

# 官网公开咨询使用独立的公开知识 Dify 应用。
CS_PUBLIC_DIFY_API_KEY=

# legacy 配套 stu.yml；workspace 配套 stu-workspace.yml，业务经学生确认后由后端执行。
# 应用 027、028 迁移并绑定两国公开知识库后，设置为 workspace。
STU_ASSISTANT_MODE=legacy
STU_DIFY_API_KEY=
# Dify 外部知识检索的独立服务密钥，服务端生成随机值；不得放入前端或工作流导出文件。
STU_KNOWLEDGE_TOKEN=
# Mem0 Platform key（可选）。留空则用本地 stu_mem0_memory，按账号隔离长期记忆。
MEM0_API_KEY=
# Separate Mem0 Platform key for signed-in website customer service portraits.
CS_MEM0_API_KEY=

# 学生助手独立容量（与客服 /api/cs/chat 分开计数）。
# STU_CHAT_MAX_CONCURRENT=8
# STU_CHAT_QUEUE_TIMEOUT_SEC=3
# STU_CHAT_RATE_PER_MINUTE_PER_IP=30

# 顾问侧客户材料规则研判。
PF_DIFY_API_KEY=

# 公司类投诉的接单主管账号 ID，由服务端配置。
# COMPANY_COMPLAINT_MANAGER_ID=

# 员工正式报告使用单独的 Dify Workflow API 密钥。
# Private 32-node ENT Chatflow, server-side only.
DIFY_ENT_CHATFLOW_API_KEY=
# 可选转写专用 Dify 应用密钥。留空时使用已启用转写的企业助手应用。
DIFY_REPORT_TRANSCRIPTION_API_KEY=
DIFY_EMPLOYEE_FORMAL_API_KEY=

# Optional OpenAI-compatible model for aggregate complaint and wellbeing suggestions.
REPORTING_LLM_BASE_URL=
REPORTING_LLM_API_KEY=
REPORTING_LLM_MODEL=
