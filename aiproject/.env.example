DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=education_service
DB_USER=root
DB_PASSWORD=change_me
UPLOAD_DIR=./data/uploads

# 本地联调用服务间 Bearer（勿提交真实值；不等于员工身份）
AUTH_BEARER_TOKEN=

# blocked | trusted_jwt（未实现时等同 blocked）。漏洞复现：uvicorn tests.repro.asgi_app:app
EMPLOYEE_IDENTITY_MODE=blocked

# BASE RS256 私钥只放在仓库外的文件，或由本机环境注入。不要把真实私钥写进 Git 或数据库。
# 未配置时 JWKS 返回 503。示例字段：kid、status(active|verify_only|disabled)、public_pem；仅 active 可带 private_pem。
# BASE_JWT_KEYS_FILE=
